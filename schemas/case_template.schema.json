{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "case_template.schema.json",
  "title": "Case Template",
  "description": "Defines a reusable phone case template: device x case_type x view",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "device_id", "case_type", "view", "canvas", "print_region", "layers"],
  "if": {
    "properties": { "status": { "const": "production" } },
    "required": ["status"]
  },
  "then": {
    "required": ["provenance"],
    "properties": {
      "provenance": {
        "properties": {
          "supplier_geometry": {
            "not": {
              "pattern": "^(?i)(none|n/?a|unknown|tbd|tbc|pending|provisional|placeholder|prototype|best[ -]?effort|approximate|estimated|visual[ -]?estimate|reference only|not (yet|available|production)|none yet)\\b",
              "description": "Production templates must have an actual supplier geometry reference (dieline, CAD file, SKU, etc.), not a non-production sentinel like 'none', 'n/a', 'unknown', or 'prototype'."
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Template schema version. Must be 1 for Phase 1."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Template ID, e.g. 'iphone-17e__hard__rear'"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Device registry ID, e.g. 'iphone-17e'"
    },
    "case_type": {
      "type": "string",
      "enum": ["hard", "tough", "magsafe", "transparent", "soft"],
      "description": "Case material/type"
    },
    "view": {
      "type": "string",
      "enum": ["rear", "angle", "front", "closeup"],
      "description": "Camera view angle"
    },
    "status": {
      "type": "string",
      "enum": ["prototype", "production"],
      "description": "Template status. Defaults to 'prototype' when omitted — legacy templates are never silently promoted to production. Production status requires provenance with production-grade supplier_geometry."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_device_dimensions", "estimated_device_anchors", "assumed_case_parameters", "supplier_geometry"],
      "description": "Structured geometry provenance — classifies where each piece of template geometry comes from.",
      "properties": {
        "verified_device_dimensions": {
          "type": "string",
          "description": "Officially verified device body dimensions (e.g. from manufacturer spec pages)."
        },
        "estimated_device_anchors": {
          "type": "string",
          "description": "Visually estimated device features (camera layout, corner radius, button positions, etc.)."
        },
        "assumed_case_parameters": {
          "type": "string",
          "description": "Prototype assumptions about case construction (thickness, print bezel, etc.)."
        },
        "supplier_geometry": {
          "type": "string",
          "description": "Supplier-provided case geometry source (dieline, CAD file, supplier SKU). Set to 'none — not a production SKU template' for prototype templates. Must reference actual geometry for production status."
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 100, "maximum": 8000},
        "height": {"type": "integer", "minimum": 100, "maximum": 8000}
      }
    },
    "print_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "x", "y", "width", "height", "fit"],
      "properties": {
        "mode": {"type": "string", "enum": ["mask", "quad"]},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fit": {"type": "string", "enum": ["cover", "contain", "tile"]},
        "mask": {"type": ["string", "null"]}
      }
    },
    "camera_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "description": "Optional camera hardware region bounding box (in template canvas pixels). Used for geometry-aware review crops and visual QA. Not required for rendering.",
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"type": "string", "enum": ["base", "artwork", "highlight", "overlay", "shadow"]},
          "file": {"type": ["string", "null"]},
          "blend": {"type": "string", "enum": ["normal", "multiply", "screen", "overlay", "darken", "lighten"]},
          "opacity": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
